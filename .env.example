# SpeechScribe Environment Variables
# Copy this file to .env and fill in your values

# JWT secret key for authentication (REQUIRED - min 32 chars, change for production!)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-with-command-above

# Admin login credentials (REQUIRED - seeded on first startup)
ADMIN_USERNAME=testuser
ADMIN_PASSWORD=testpassword

# Encryption key for API key storage (optional - fallback: JWT_SECRET_KEY)
ENCRYPTION_KEY=

# OpenAI API key for integration tests (optional — stored in user DB by test fixtures)
TEST_OPENAI_API_KEY=

# Show "Test-Anmeldedaten" button on login page (optional - default: true, set false for production)
DEV_AUTOLOGIN=true

# Test user credentials (optional - created on startup when DEV_AUTOLOGIN=true)
TEST_USERNAME=arzt
TEST_PASSWORD=arzt1234

# Logging (optional - defaults shown)
LOG_RETENTION_DAYS=30
LOG_CLEANUP_ENABLED=true

# Frontend URL for CORS (optional - leave empty for default origins only)
FRONTEND_URL=

# App info
APP_NAME=PARK_SPEECH
APP_VERSION=3.1.0
BUILD_DATE=2026-03-28
